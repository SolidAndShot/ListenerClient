  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_author}"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.solidandshot.listenerclient.ListenerClient"]
  },
  "mixins": ["listenerclient.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_short_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  }
}
